---
import Navbar from "@/components/Navbar";
import ThemeIcon from "../components/ThemeIcon.astro";
const { children } = Astro.props;
const { class: className = "" } = Astro.props;
---

<div
  class={`relative flex h-full min-w-0 items-center justify-center overflow-x-hidden bg-white font-sans dark:bg-black ${className}`}
>
  <ThemeIcon class="absolute top-3.5 right-4 z-20 cursor-pointer" />

  <div
    class="absolute inset-0 pointer-events-none bg-[length:40px_40px] bg-[linear-gradient(to_right,_#e4e4e7_1px,_transparent_1px),_linear-gradient(to_bottom,_#e4e4e7_1px,_transparent_1px)] dark:bg-[linear-gradient(to_right,_#262626_1px,_transparent_1px),_linear-gradient(to_bottom,_#262626_1px,_transparent_1px)]"
  >
  </div>

  <div
    class="absolute inset-0 pointer-events-none flex items-center justify-center bg-white dark:bg-black [mask-image:radial-gradient(ellipse_at_center,_#00000079_20%,_black)] [-webkit-mask-image:radial-gradient(ellipse_at_center,_#00000079_20%,_black)]"
  >
  </div>

  <main class="z-20 flex h-full min-w-0 w-full justify-center">
    <div
      class="w-full min-w-0 max-w-screen-md px-4 sm:px-6 md:max-w-screen-lg xl:max-w-screen-xl"
    >
      <slot />
    </div>
  </main>

  <Navbar client:load />
</div>
